__PUBLIC_HOST__ {
    tls {
        issuer acme {
            dir https://acme.zerossl.com/v2/DV90
            email __ACME_EMAIL__
        }
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            email __ACME_EMAIL__
        }
    }

    handle /healthz {
        respond "ok" 200
    }

    @authorizedDerivedWhep {
        path_regexp derived_whep ^/court[1-8]_(preview|program|monitor|calibration)/whep(/.*)?$
        query user=__DERIVED_READ_USER__ pass=__DERIVED_READ_PASS__
    }
    handle @authorizedDerivedWhep {
        reverse_proxy 127.0.0.1:8889
    }

    @authorizedDerivedHls {
        path_regexp derived_hls ^/court[1-8]_(preview|program|monitor|calibration)/.*$
        query user=__DERIVED_READ_USER__ pass=__DERIVED_READ_PASS__
    }
    handle @authorizedDerivedHls {
        reverse_proxy 127.0.0.1:8888 {
            header_up Authorization "Bearer __HLS_CDN_SECRET__"
        }
    }

    @protectedMedia path_regexp protected_media ^/court[1-8]_(raw|normalized|preview|program|monitor|calibration)/.*$
    handle @protectedMedia {
        respond "unauthorized" 401
    }

    respond "not found" 404
}
