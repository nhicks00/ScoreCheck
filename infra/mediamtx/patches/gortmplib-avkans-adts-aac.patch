diff --git a/reader_adts_compat_test.go b/reader_adts_compat_test.go
new file mode 100644
index 0000000..73d368b
--- /dev/null
+++ b/reader_adts_compat_test.go
@@ -0,0 +1,59 @@
+package gortmplib
+
+import (
+	"io"
+	"testing"
+	"time"
+
+	"github.com/bluenviron/mediacommon/v2/pkg/codecs/mpeg4audio"
+	"github.com/stretchr/testify/require"
+
+	"github.com/bluenviron/gortmplib/pkg/codecs"
+	"github.com/bluenviron/gortmplib/pkg/message"
+)
+
+type adtsCompatConn struct {
+	messages []message.Message
+	position int
+}
+
+func (*adtsCompatConn) BytesReceived() uint64       { return 0 }
+func (*adtsCompatConn) BytesSent() uint64           { return 0 }
+func (*adtsCompatConn) Write(message.Message) error { return nil }
+
+func (c *adtsCompatConn) Read() (message.Message, error) {
+	if c.position >= len(c.messages) {
+		return nil, io.EOF
+	}
+	value := c.messages[c.position]
+	c.position++
+	return value, nil
+}
+
+func TestReaderAcceptsAACConfigOnAccessUnit(t *testing.T) {
+	config := &mpeg4audio.AudioSpecificConfig{
+		Type:          2,
+		SampleRate:    48000,
+		ChannelConfig: 2,
+		ChannelCount:  2,
+	}
+	conn := &adtsCompatConn{messages: []message.Message{
+		&message.Audio{Codec: message.CodecMPEG4Audio, AACType: message.AudioAACTypeAU, AACConfig: config, AU: []byte{0x01, 0x02}},
+		&message.Audio{DTS: 2 * time.Second, Codec: message.CodecMPEG4Audio, AACType: message.AudioAACTypeAU, AACConfig: config, AU: []byte{0x03, 0x04}},
+	}}
+	reader := &Reader{Conn: conn}
+	require.NoError(t, reader.Initialize())
+
+	tracks := reader.Tracks()
+	require.Len(t, tracks, 1)
+	audio, ok := tracks[0].Codec.(*codecs.MPEG4Audio)
+	require.True(t, ok)
+	require.Equal(t, config, audio.Config)
+
+	var received []byte
+	reader.OnDataMPEG4Audio(tracks[0], func(_ time.Duration, accessUnit []byte) {
+		received = append([]byte(nil), accessUnit...)
+	})
+	require.NoError(t, reader.Read())
+	require.Equal(t, []byte{0x01, 0x02}, received)
+}
