+++ b/pkg/message/msg_audio_compat_test.go
@@ -0,0 +1,39 @@
+package message
+
+import (
+	"testing"
+	"time"
+
+	"github.com/bluenviron/gortmplib/pkg/rawmessage"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAudioUnmarshalADTSWrappedAAC(t *testing.T) {
+	raw := &rawmessage.Message{
+		ChunkStreamID:   AudioChunkStreamID,
+		Timestamp:       14 * time.Millisecond,
+		Type:            uint8(TypeAudio),
+		MessageStreamID: 1,
+		Body: []byte{
+			0xff,
+			0xff, 0xf1, 0x4c, 0x80, 0x01, 0x3f, 0xfc,
+			0x01, 0x02,
+		},
+	}
+
+	var actual Audio
+	require.NoError(t, actual.unmarshal(raw))
+	require.Equal(t, uint8(CodecMPEG4Audio), actual.Codec)
+	require.Equal(t, AudioAACTypeAU, actual.AACType)
+	require.Equal(t, 48000, actual.AACConfig.SampleRate)
+	require.Equal(t, 2, actual.AACConfig.ChannelCount)
+	require.Equal(t, []byte{0x01, 0x02}, actual.AU)
+}
+
+func TestAudioUnmarshalRejectsOtherCodec15(t *testing.T) {
+	raw := &rawmessage.Message{Body: []byte{0xff, 0x01}}
+
+	var actual Audio
+	err := actual.unmarshal(raw)
+	require.EqualError(t, err, "unsupported audio codec: 15")
+}
